# Local demo values. Change before deployment; use URL-safe passwords.
API_KEY=local-development-key-change-me
POSTGRES_PASSWORD=localpostgrespassword
RABBITMQ_PASSWORD=localrabbitpassword
DATABASE_URL=postgresql+asyncpg://payments:localpostgrespassword@localhost:5432/payments
RABBITMQ_URL=amqp://payments:localrabbitpassword@localhost:5672/
RETRY_BASE_SECONDS=1
OUTBOX_POLL_SECONDS=0.5
WEBHOOK_TIMEOUT_SECONDS=10
